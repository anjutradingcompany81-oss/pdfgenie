generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  // Null for OAuth-only accounts (no password set).
  password      String?
  image         String?
  role          Role      @default(USER)
  disabled      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  resetTokens       PasswordResetToken[]
  toolUsage         ToolUsageEvent[]
  subscription      Subscription?
  billingHistory    BillingHistory[]
  mailMergeJobs     MailMergeJob[]
  emailTemplates    EmailTemplate[]
  smtpCredential    SmtpCredential?
  signatureRequests SignatureRequest[]
  pdfConversionJobs PdfConversionJob[]

  @@map("users")
}

// Standard Auth.js adapter models below (Account/Session/VerificationToken).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Defined for completeness / future use with OAuth-only sign-in. Because a
// Credentials provider is configured, Auth.js requires the "jwt" session
// strategy at runtime (see lib/auth.ts) — this table is not written to
// while that's the case.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Lightweight, privacy-respecting usage counter: just a tool slug, an
// optional user, and a timestamp. No file names, content, or metadata.
model ToolUsageEvent {
  id        String   @id @default(cuid())
  toolSlug  String
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([toolSlug])
  @@index([createdAt])
  @@map("tool_usage_events")
}

model SiteSettings {
  id               Int      @id @default(1)
  siteName         String   @default("PDF Genie")
  logoUrl          String?
  contactEmail     String?
  footerText       String?
  maxFileSizeMb    Int      @default(50)
  allowedFileTypes String   @default("pdf,png,jpg,jpeg,docx,doc")
  maintenanceMode  Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  @@map("site_settings")
}

model ContentPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("content_pages")
}

// ---------------------------------------------------------------------------
// Subscription / billing provision. None of this is wired to a real payment
// gateway yet (see lib/payments/) — every user is implicitly on the Free
// plan (lib/plans/get-current-plan.ts) regardless of what's in these tables.
// They exist so a real billing integration is additive, not a schema
// migration + refactor of everything that currently reads limits from
// lib/plans/config.ts.
// ---------------------------------------------------------------------------

enum PlanKey {
  FREE
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentProviderKind {
  STRIPE
  RAZORPAY
  PAYPAL
  PADDLE
}

// Seeded with FREE/PREMIUM/ENTERPRISE rows (see prisma/seed.ts) so future
// billing code has real IDs to reference. isActive is false for everything
// but FREE until a plan is actually purchasable.
model Plan {
  id         String   @id @default(cuid())
  key        PlanKey  @unique
  name       String
  priceCents Int      @default(0)
  interval   String   @default("month")
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String               @id @default(cuid())
  userId                 String               @unique
  planId                 String
  status                 SubscriptionStatus   @default(ACTIVE)
  provider               PaymentProviderKind?
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodEnd       DateTime?
  // Set true when the user cancels but keeps access through the period
  // they already paid for (Razorpay's cancelAtCycleEnd). Status stays
  // ACTIVE until the real subscription.cancelled webhook lands at period
  // end, so this flag is what the dashboard uses to show "ends on X"
  // instead of the normal plan controls in the meantime.
  cancelAtPeriodEnd      Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           Plan             @relation(fields: [planId], references: [id])
  billingHistory BillingHistory[]

  @@map("subscriptions")
}

// Not written to by any active code path yet — no payment gateway is wired up.
model BillingHistory {
  id             String               @id @default(cuid())
  userId         String
  subscriptionId String?
  amountCents    Int
  currency       String               @default("usd")
  status         String
  provider       PaymentProviderKind?
  invoiceUrl     String?
  createdAt      DateTime             @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("billing_history")
}

enum UsageIdentifierType {
  USER
  ANONYMOUS
}

// Real, active table — backs the free-plan daily email limit for both
// signed-in and anonymous users (see lib/usage-tracking.ts).
model UsageCounter {
  id             String              @id @default(cuid())
  identifierType UsageIdentifierType
  identifier     String
  // YYYY-MM-DD (UTC) rather than a DateTime — keeps "per calendar day"
  // queries a plain equality check instead of a range.
  date           String
  emailsSent     Int                 @default(0)
  jobsCount      Int                 @default(0)

  @@unique([identifierType, identifier, date])
  @@map("usage_counters")
}

enum MailMergeJobStatus {
  PENDING
  SENDING
  COMPLETED
  FAILED
  BLOCKED
  PAUSED
  CANCELLED
}

model MailMergeJob {
  id              String             @id @default(cuid())
  userId          String?
  anonymousId     String?
  status          MailMergeJobStatus @default(PENDING)
  subject         String
  // Stored (not just the rendered per-recipient copies) so a failed-email
  // retry can re-render from the original template + each recipient's
  // saved field snapshot, without needing the source Excel file again.
  bodyTemplate    String             @db.Text
  // Just the From address used — never a password. See MailMergeRecipient
  // for why SMTP credentials themselves are never persisted at all.
  senderEmail     String?
  recipientCount  Int
  attachmentCount Int                @default(0)
  errorMessage    String?
  createdAt       DateTime           @default(now())
  completedAt     DateTime?

  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipients MailMergeRecipient[]

  @@index([userId])
  @@index([anonymousId])
  @@map("mail_merge_jobs")
}

enum MailMergeRecipientStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model MailMergeRecipient {
  id              String                   @id @default(cuid())
  jobId           String
  email           String
  cc              String?
  bcc             String?
  status          MailMergeRecipientStatus @default(PENDING)
  error           String?
  smtpResponse    String?                  @db.Text
  retryCount      Int                      @default(0)
  // Comma-joined names of the uploaded attachment(s) actually sent to this
  // recipient — resolved per-row from an "Attachment" column when present,
  // see lib/mail-merge/resolve-attachments.ts.
  attachmentNames String?
  // Snapshot of this recipient's Excel row (minus any PDF-password column,
  // which is deliberately never persisted — see resolvePdfPassword in
  // lib/mail-merge/render-template.ts). Needed to re-render the template on
  // retry without the original file.
  fields          Json?
  sentAt          DateTime?
  // Captured when send-recipient.ts sends successfully — the provider's
  // message-id and how long the SMTP call took, surfaced in the log export.
  messageId       String?
  durationMs      Int?

  job MailMergeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("mail_merge_recipients")
}

// Real signups from "Notify Me" clicks on premium-gated features — no
// payment involved, just capturing interest.
model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String
  feature   String
  createdAt DateTime @default(now())

  @@map("waitlist_signups")
}

// Built-in templates have userId = null and isBuiltIn = true, seeded once
// (see prisma/seed.ts) and treated as read-only by the UI. User-saved
// templates are real, editable/duplicable/deletable rows.
model EmailTemplate {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  subject   String
  body      String   @db.Text
  isBuiltIn Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_templates")
}

// A signed-in user's own SMTP login for Mail Merge, saved so they don't have
// to re-enter it every job. One row per user (userId unique) — re-verifying
// with different details overwrites it in place. `passwordEnc` is AES-256-GCM
// ciphertext (see lib/mail-merge/smtp-credential-crypto.ts), never plaintext;
// anonymous users never get a row here, matching the anonymous-only "never
// persisted, in-memory for this job only" flow that predates this table.
model SmtpCredential {
  id          String   @id @default(cuid())
  userId      String   @unique
  host        String
  port        Int
  secure      Boolean
  smtpUser    String
  passwordEnc String   @db.Text
  fromEmail   String
  fromName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("smtp_credentials")
}

enum SignatureRequestStatus {
  PENDING
  SIGNED
  CANCELLED
}

// A shareable, no-login signing link: the sender places where a signature
// should go, we store the PDF, and anyone holding the link can open and
// sign it. `token` is the only access control — there are no recipient
// accounts, matching the "simple, no email delivery" scope this shipped
// with. This and PdfConversionJob (below) are the only features that store
// a file server-side; every other tool processes entirely client-side and
// never uploads anything (see lib/uploads.ts).
model SignatureRequest {
  id           String                 @id @default(cuid())
  userId       String?
  anonymousId  String?
  token        String                 @unique @default(cuid())
  status       SignatureRequestStatus @default(PENDING)
  fileName     String
  // Filenames under uploads/signature-requests/ (see lib/uploads.ts) — never
  // a full path, so the serving route stays traversal-safe.
  sourceFile   String
  signedFile   String?
  // Where the recipient's signature gets flattened in, chosen by the sender
  // before sharing the link (same ratio/point convention as lib/pdf/sign.ts).
  pageIndex    Int
  xRatio       Float
  yRatio       Float
  wRatio       Float
  hRatio       Float
  pageWidthPt  Float
  pageHeightPt Float
  createdAt    DateTime               @default(now())
  signedAt     DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([anonymousId])
  @@map("signature_requests")
}

enum PdfConversionTargetFormat {
  WORD
  EXCEL
}

enum PdfConversionStatus {
  PENDING
  COMPLETED
  FAILED
}

// Audit-only usage record for the API-based PDF→Word/PDF→Excel conversion
// (see lib/pdf-conversion/) — never the document content itself, only
// metadata needed for cost tracking and future plan limits. The PDF and its
// converted output live for a few minutes under the OS temp directory (see
// lib/pdf-conversion/temp-storage.ts) and are gone well before this row's
// createdAt would be queried for anything.
model PdfConversionJob {
  id               String                    @id @default(cuid())
  userId           String?
  anonymousId      String?
  targetFormat     PdfConversionTargetFormat
  provider         String
  status           PdfConversionStatus       @default(PENDING)
  pageCount        Int?
  fileSizeBytes    Int?
  processingTimeMs Int?
  errorCode        String?
  createdAt        DateTime                  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([anonymousId])
  @@index([createdAt])
  @@map("pdf_conversion_jobs")
}
