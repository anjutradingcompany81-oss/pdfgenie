generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  // Null for OAuth-only accounts (no password set).
  password      String?
  image         String?
  role          Role      @default(USER)
  disabled      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  toolUsage      ToolUsageEvent[]
  subscription   Subscription?
  billingHistory BillingHistory[]
  mailMergeJobs  MailMergeJob[]

  @@map("users")
}

// Standard Auth.js adapter models below (Account/Session/VerificationToken).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Defined for completeness / future use with OAuth-only sign-in. Because a
// Credentials provider is configured, Auth.js requires the "jwt" session
// strategy at runtime (see lib/auth.ts) — this table is not written to
// while that's the case.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Lightweight, privacy-respecting usage counter: just a tool slug, an
// optional user, and a timestamp. No file names, content, or metadata.
model ToolUsageEvent {
  id        String   @id @default(cuid())
  toolSlug  String
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([toolSlug])
  @@index([createdAt])
  @@map("tool_usage_events")
}

model SiteSettings {
  id               Int      @id @default(1)
  siteName         String   @default("PDF Genie")
  logoUrl          String?
  contactEmail     String?
  footerText       String?
  maxFileSizeMb    Int      @default(50)
  allowedFileTypes String   @default("pdf,png,jpg,jpeg,docx,doc")
  maintenanceMode  Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  @@map("site_settings")
}

model ContentPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("content_pages")
}

// ---------------------------------------------------------------------------
// Subscription / billing provision. None of this is wired to a real payment
// gateway yet (see lib/payments/) — every user is implicitly on the Free
// plan (lib/plans/get-current-plan.ts) regardless of what's in these tables.
// They exist so a real billing integration is additive, not a schema
// migration + refactor of everything that currently reads limits from
// lib/plans/config.ts.
// ---------------------------------------------------------------------------

enum PlanKey {
  FREE
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentProviderKind {
  STRIPE
  RAZORPAY
  PAYPAL
  PADDLE
}

// Seeded with FREE/PREMIUM/ENTERPRISE rows (see prisma/seed.ts) so future
// billing code has real IDs to reference. isActive is false for everything
// but FREE until a plan is actually purchasable.
model Plan {
  id         String   @id @default(cuid())
  key        PlanKey  @unique
  name       String
  priceCents Int      @default(0)
  interval   String   @default("month")
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

// Not written to by any active code path yet.
model Subscription {
  id                     String               @id @default(cuid())
  userId                 String               @unique
  planId                 String
  status                 SubscriptionStatus   @default(ACTIVE)
  provider               PaymentProviderKind?
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodEnd       DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           Plan             @relation(fields: [planId], references: [id])
  billingHistory BillingHistory[]

  @@map("subscriptions")
}

// Not written to by any active code path yet — no payment gateway is wired up.
model BillingHistory {
  id             String               @id @default(cuid())
  userId         String
  subscriptionId String?
  amountCents    Int
  currency       String               @default("usd")
  status         String
  provider       PaymentProviderKind?
  invoiceUrl     String?
  createdAt      DateTime             @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("billing_history")
}

enum UsageIdentifierType {
  USER
  ANONYMOUS
}

// Real, active table — backs the free-plan daily email limit for both
// signed-in and anonymous users (see lib/usage-tracking.ts).
model UsageCounter {
  id             String              @id @default(cuid())
  identifierType UsageIdentifierType
  identifier     String
  // YYYY-MM-DD (UTC) rather than a DateTime — keeps "per calendar day"
  // queries a plain equality check instead of a range.
  date           String
  emailsSent     Int                 @default(0)
  jobsCount      Int                 @default(0)

  @@unique([identifierType, identifier, date])
  @@map("usage_counters")
}

enum MailMergeJobStatus {
  PENDING
  SENDING
  COMPLETED
  FAILED
  BLOCKED
}

model MailMergeJob {
  id              String             @id @default(cuid())
  userId          String?
  anonymousId     String?
  status          MailMergeJobStatus @default(PENDING)
  subject         String
  recipientCount  Int
  attachmentCount Int                @default(0)
  errorMessage    String?
  createdAt       DateTime           @default(now())
  completedAt     DateTime?

  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipients MailMergeRecipient[]

  @@index([userId])
  @@index([anonymousId])
  @@map("mail_merge_jobs")
}

enum MailMergeRecipientStatus {
  PENDING
  SENT
  FAILED
}

model MailMergeRecipient {
  id     String                   @id @default(cuid())
  jobId  String
  email  String
  status MailMergeRecipientStatus @default(PENDING)
  error  String?
  sentAt DateTime?

  job MailMergeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("mail_merge_recipients")
}

// Real signups from "Notify Me" clicks on premium-gated features — no
// payment involved, just capturing interest.
model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String
  feature   String
  createdAt DateTime @default(now())

  @@map("waitlist_signups")
}
