# Copy this to .env.local for local development. On the VPS, these live in
# deploy-secrets.json instead (gitignored, spread into PM2's env by
# ecosystem.config.js) — see that file's header comment.
#
# Never commit real values. Nothing in this file should ever contain an
# actual secret.

# --- Database -----------------------------------------------------------
DATABASE_URL=

# --- Auth (NextAuth / Google OAuth) --------------------------------------
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin dashboard ------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- Billing (Razorpay) ---------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PREMIUM=
RAZORPAY_PLAN_ID_ENTERPRISE=

# --- Mail Merge (per-user SMTP credential encryption) ---------------------
SMTP_CREDENTIAL_ENCRYPTION_KEY=
SMTP_FROM=

# --- PDF conversion (PDF -> Word / PDF -> Excel) --------------------------
# Selects which provider implements lib/pdf-conversion/provider.ts's
# PDFConversionProvider interface. Adding a third provider (Apryse, ABBYY,
# ...) means writing one new provider file and adding a case to the factory
# in provider.ts — this value is the only thing that changes to switch.
#
#   adobe       — best quality (fonts/tables/images/layout), needs a paid
#                 Adobe Developer Console account (see ADOBE_PDF_* below).
#   self-hosted — free, no account, runs entirely on this VPS via
#                 scripts/pdf_conversion_server.py (pdf2docx + pdfplumber).
#                 Good for PDF -> Word; PDF -> Excel table detection is
#                 noticeably less reliable than Adobe's on complex tables.
PDF_CONVERSION_PROVIDER=adobe

# Adobe PDF Services API credentials (https://developer.adobe.com/document-services/),
# only used when PDF_CONVERSION_PROVIDER=adobe. Create a project in the
# Adobe Developer Console, add the PDF Services API, and generate a
# Client ID/Secret there — server-to-server OAuth, no separate org ID
# needed. Until these are set (or the provider is switched to
# "self-hosted"), PDF -> Word and PDF -> Excel automatically fall back to
# the basic client-side conversion (see ProviderNotConfiguredError in
# lib/pdf-conversion-client.ts) rather than breaking outright.
ADOBE_PDF_CLIENT_ID=
ADOBE_PDF_CLIENT_SECRET=

# Port for the self-hosted conversion service, only used when
# PDF_CONVERSION_PROVIDER=self-hosted. Matches WHISPER_PORT's convention —
# see scripts/pdf_conversion_server.py and scripts/whisper_server.py.
PDF_CONVERSION_SELF_HOSTED_PORT=5007

# How long a converted file (and its job record) survives before cleanup —
# also applied as a safety-net sweep for jobs that failed before their own
# cleanup ran. See lib/pdf-conversion/temp-storage.ts.
FILE_RETENTION_MINUTES=30

# Upload limits enforced before any file reaches the conversion provider.
# See lib/pdf-conversion/validation.ts.
MAX_PDF_SIZE_MB=100
MAX_PDF_PAGES=500
