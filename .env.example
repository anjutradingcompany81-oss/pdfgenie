# Copy this to .env.local for local development. On the VPS, these live in
# deploy-secrets.json instead (gitignored, spread into PM2's env by
# ecosystem.config.js) — see that file's header comment.
#
# Never commit real values. Nothing in this file should ever contain an
# actual secret.

# --- Database -----------------------------------------------------------
DATABASE_URL=

# --- Auth (NextAuth / Google OAuth) --------------------------------------
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin dashboard ------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- Billing (Razorpay) ---------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PREMIUM=
RAZORPAY_PLAN_ID_ENTERPRISE=

# --- Mail Merge (per-user SMTP credential encryption) ---------------------
SMTP_CREDENTIAL_ENCRYPTION_KEY=
SMTP_FROM=

# --- PDF conversion (PDF -> Word / PDF -> Excel) --------------------------
# Selects which provider implements lib/pdf-conversion/provider.ts's
# PDFConversionProvider interface. Only "adobe" exists today; adding
# Apryse/ABBYY/etc. later means writing one new provider file and adding a
# case to the factory in provider.ts — this value is the only thing that
# changes to switch.
PDF_CONVERSION_PROVIDER=adobe

# Adobe PDF Services API credentials (https://developer.adobe.com/document-services/).
# Create a project in the Adobe Developer Console, add the PDF Services API,
# and generate a Client ID/Secret there — server-to-server OAuth, no
# separate org ID needed. Until these are set, PDF -> Word and PDF -> Excel
# automatically fall back to the existing free client-side conversion (see
# ProviderNotConfiguredError in lib/pdf-conversion-client.ts) rather than
# breaking outright.
ADOBE_PDF_CLIENT_ID=
ADOBE_PDF_CLIENT_SECRET=

# How long a converted file (and its job record) survives before cleanup —
# also applied as a safety-net sweep for jobs that failed before their own
# cleanup ran. See lib/pdf-conversion/temp-storage.ts.
FILE_RETENTION_MINUTES=30

# Upload limits enforced before any file reaches the conversion provider.
# See lib/pdf-conversion/validation.ts.
MAX_PDF_SIZE_MB=100
MAX_PDF_PAGES=500
